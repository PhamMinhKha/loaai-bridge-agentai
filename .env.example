PORT=3000
# 0.0.0.0 = cho máy khác trong LAN truy cập; 127.0.0.1 = chỉ máy này
HOST=0.0.0.0

STT_PROVIDER=whisper
WHISPER_MODEL=medium
WHISPER_PYTHON=python
# Lưu mỗi câu STT + WAV vào data/stt/ (STT_DUMP=false để tắt)
STT_DUMP=true
# Câu ảo giác Whisper (subscribe / Ghiền Mì Gõ) bị bỏ, coi như chưa nói
# STT_DUMP_DIR=data/stt

# none | pyttsx3 | edge | google  (edge-tts vẫn được chấp nhận, map về edge)
TTS_PROVIDER=pyttsx3
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_PYTHON=python
TTS_RATE=160

# mock | openclaw | hermes
AGENT_PROVIDER=mock

# OpenClaw Gateway — bật POST /v1/chat/completions (port mặc định 18789)
OPENCLAW_URL=http://127.0.0.1:18789
OPENCLAW_TOKEN=
OPENCLAW_MODEL=openclaw/default

# Hermes Agent API server — API_SERVER_ENABLED=true, port mặc định 8642
HERMES_URL=http://127.0.0.1:8642
HERMES_TOKEN=
HERMES_MODEL=hermes-agent

# Hermes/OpenClaw có tool (web search) thường > 60s
AGENT_TIMEOUT_MS=180000
# Chờ trả lời để đọc TTS (ms). Hết hạn thì chạy nền, Telegram báo khi xong.
AGENT_WAIT_MS=90000
# Job nền tối đa (ms) — 30 phút
AGENT_MAX_MS=1800000

# Mirror web/ESP32 chat to Telegram via `hermes send` (uses Hermes .env, not VG token)
TELEGRAM_SYNC=true
TELEGRAM_TO=telegram

LISTEN_MS=30000
SILENCE_MS=1200
PARTIAL_ENABLED=false

# JPEG tối đa 360px ngang (ESP32), cao tự scale
SCREENSHOT_MAX_WIDTH=360
SCREENSHOT_QUALITY=60
